# Copy this to .env and fill in your values. Never commit .env.

# ---- LLM provider -----------------------------------------------------------
# ollama (default, fully local) | openai (OpenAI or any OpenAI-compatible server)
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192          # context window; the doc batch needs more than Ollama's default
OLLAMA_KEEP_ALIVE=10m        # keep the model in memory between requests

# OpenAI-compatible (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...                      # real key for OpenAI; anything for local servers
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:1234/v1   # LM Studio. llama.cpp: http://localhost:8080/v1

# Generation
LLM_TIMEOUT=300              # seconds; CPU-only inference can take a while
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_CHAR_BUDGET=14000       # document text per request; raise with OLLAMA_NUM_CTX

# ---- Audit logging ------------------------------------------------------------
# local (default) | s3 | none
LOG_BACKEND=local
LOG_DIR=logs

# ---- Uploads ------------------------------------------------------------------
UPLOAD_DIR=uploads

# Only for LOG_BACKEND=s3 (or use an IAM role / AWS CLI profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=ai-dashboard-logs

PORT=8000
